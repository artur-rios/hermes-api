# Hermes in production, deployed from a release pull request into main. The copy lives at
# /etc/yggdrasil/production/hermes-api.env and is never committed.
# Production holds the Mailgun credentials, and refuses to start without them or without an alert address.
ASPNETCORE_ENVIRONMENT=Production

# Required here.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_API_VERSION=v3
# The sender of the owner's alerts, on the Mailgun domain. Defaults to postmaster@ the domain.
# MAILGUN_FROM=

# Required here: the owner's address for alerts.
HERMES_ALERT_TO=

# One block per client, numbered from 0. Key hashes are the SHA-256 of an active key, one or two per client.
# HERMES_CLIENTS__0__ID=
# HERMES_CLIENTS__0__KEYHASHES__0=
# HERMES_CLIENTS__0__SENDER=
# HERMES_CLIENTS__0__RECIPIENTPOLICY=fixed
# HERMES_CLIENTS__0__ALLOWEDRECIPIENTS__0=
# HERMES_CLIENTS__0__LIMITPERMINUTE=
# HERMES_CLIENTS__0__LIMITPERDAY=
