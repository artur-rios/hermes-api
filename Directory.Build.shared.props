<Project>

  <!--
    The build settings every project shares, production and test alike. MSBuild stops at the nearest
    Directory.Build.props, so src/Directory.Build.props and tests/Directory.Build.props each import
    this file and add only what is particular to them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
